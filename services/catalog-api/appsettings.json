{
  "Tenancy": {
    "DefaultStoreId": 1
  },
  "Persistence": "Json",
  "ConnectionStrings": {
    "Postgres": "",
    "Default": ""
  },
  "Data": {
    "Root": "../../data"
  },
  "Cors": {
    "Origins": [
      "http://localhost:8080",
      "http://127.0.0.1:8080",
      "http://localhost:8081",
      "http://127.0.0.1:8081",
      "http://localhost:5500",
      "https://localhost:5500",
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "https://wadelivery.com.br",
      "https://www.wadelivery.com.br",
      "https://*.wadelivery.com.br"
    ]
  },
  "Security": {
    "AllowInsecureDefaults": false
  },
  "Captcha": {
    "Enabled": false,
    "AllowDisabled": false,
    "Provider": "turnstile",
    "SiteKey": "",
    "SecretKey": ""
  },
  "Billing": {
    "AutoBlockEnabled": false,
    "BlockAfterDays": 5,
    "TrialDays": 30,
    "DefaultMonthlyFee": 0,
    "ManualUnblockGraceDays": 3,
    "IntervalMinutes": 60
  },
  "Signup": {
    "CleanupEnabled": false,
    "EmailDnsCheck": true,
    "AbandonAfterDays": 7,
    "PurgeFilesAfterDays": 30
  },
  "Platform": {
    "ProtectedStoreIds": [ 1 ]
  },
  "RemoteTools": {
    "AllowUpload": false
  },
  "SignupQuota": {
    "PerIpPerDay": 2,
    "PerHour": 20,
    "PerDay": 100,
    "MaxActiveTestStores": 500,
    "RateLimitPermit": 5,
    "RateLimitWindowMinutes": 15
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Jwt": {
    "Issuer": "delivery-catalog",
    "Audience": "delivery-clients",
    "ExpiresMinutes": "480"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
