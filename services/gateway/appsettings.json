{
  "Cors": {
    "Origins": [
      "http://localhost:8080",
      "http://127.0.0.1:8080",
      "http://localhost:8081",
      "http://127.0.0.1:8081",
      "http://localhost:5500",
      "https://localhost:5500",
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "https://wadelivery.com.br",
      "https://www.wadelivery.com.br",
      "https://*.wadelivery.com.br"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-onboarding": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/lojas/{**catch-all}" },
        "Order": 0
      },
      "catalog-route": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/v1/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/{**catch-all}" }
        ],
        "Order": 2
      },
      "catalog-uploads": {
        "ClusterId": "catalog",
        "Match": { "Path": "/uploads/{**catch-all}" },
        "Order": 0
      },
      "catalog-store": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/v1/store/{**catch-all}" },
        "Order": 1
      },
      "catalog-catalog": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/v1/catalog/{**catch-all}" },
        "Order": 1
      },
      "catalog-auth": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" },
        "Order": 1
      },
      "orders-tables": {
        "ClusterId": "orders",
        "Match": { "Path": "/api/v1/tables/{**catch-all}" },
        "Order": 1
      },
      "orders-admin-tables": {
        "ClusterId": "orders",
        "Match": { "Path": "/api/v1/admin/tables/{**catch-all}" },
        "Order": 1
      },
      "catalog-admin": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/v1/admin/{**catch-all}" },
        "Order": 1
      },
      "catalog-health": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/v1/health/catalog" },
        "Transforms": [
          { "PathPattern": "/api/v1/health" }
        ],
        "Order": 0
      },
      "orders-route": {
        "ClusterId": "orders",
        "Match": { "Path": "/api/v1/orders/{**catch-all}" },
        "Order": 0
      },
      "orders-health": {
        "ClusterId": "orders",
        "Match": { "Path": "/api/v1/health/orders" },
        "Transforms": [
          { "PathPattern": "/api/v1/health" }
        ],
        "Order": 0
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5101/" }
        }
      },
      "orders": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5102/" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
