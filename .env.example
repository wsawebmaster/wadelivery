# Copie para .env (nunca commitado) e preencha valores reais.
# Uso: docker compose --env-file .env -f docker-compose.prod.example.yml up -d --build

# --- PostgreSQL ---
POSTGRES_USER=delivery
POSTGRES_PASSWORD=troque-postgres-forte

# --- JWT (obrigatório em Production) ---
JWT_KEY=gere-uma-chave-longa-aleatoria-com-pelo-menos-32-chars

# --- Perfis do painel admin (catalog-api) ---
# Admin  → loja / cardápio / pedidos / dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-senha-admin-forte
# Dev    → administração geral da plataforma (Lojas / Sistemas)
DEV_USERNAME=dev
DEV_PASSWORD=troque-senha-dev-forte
# Atendimento → só pedidos
ATENDIMENTO_USERNAME=atendimento
ATENDIMENTO_PASSWORD=troque-senha-atendimento-forte

# --- CORS (origens exatas do app Next.js publicado) ---
CORS_ORIGIN_0=https://seu-dominio-de-producao
CORS_ORIGIN_1=https://www.seu-dominio-de-producao

# --- Front (Vercel) ---
# Para deploy, configure ambas as variáveis no projeto Next.js com a URL HTTPS do gateway.
API_BASE_URL=http://localhost:5100
NEXT_PUBLIC_API_BASE_URL=http://localhost:5100
# CAPTCHA do cadastro de lojas (Cloudflare Turnstile). Deixe vazio para não exibir o widget.
# Ao preencher, habilite também no catalog-api: Captcha__Enabled=true e Captcha__SecretKey.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_APP_BASE_URL=https://wadelivery.com.br
# Cobrança das lojas: dias de teste grátis, dias de tolerância após o vencimento antes do
# bloqueio automático e mensalidade padrão das lojas novas (0 = definir por loja em /admin/lojas).
BILLING_TRIAL_DAYS=30
BILLING_BLOCK_AFTER_DAYS=5
BILLING_DEFAULT_MONTHLY_FEE=0

# --- Opcional ---
# GATEWAY_PUBLISH_PORT=5100
# RABBITMQ_ENABLED=false
